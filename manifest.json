{
  "manifest_version": 3,
  "minimum_chrome_version": "89",
  "name": "TabJev – auto tab groups",
  "version": "0.1.0",
  "description": "Sorts every new tab into a Chrome tab group in ~150 ms using Jev (TypeSafe). Bring your own key.",
  "permissions": ["tabs", "tabGroups", "storage"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Group all tabs in this window" },
  "icons": { "16": "icons/icon128.png", "48": "icons/icon128.png", "128": "icons/icon128.png" }
}
